    select
        g1_0.id,
        g1_0.background_url,
        g1_0.created_at,
        g1_0.description,
        g2_0.game_id,
        g2_1.id,
        g2_1.image_url,
        g2_1.name,
        g2_1.rawg_id,
        g2_1.slug,
        g1_0.metacritic,
        g1_0.name,
        p1_0.game_id,
        p1_1.id,
        p1_1.name,
        p1_1.slug,
        g1_0.rating,
        g1_0.rawg_id,
        g1_0.release_date,
        g1_0.slug,
        g1_0.updated_at,
        g1_0.website,
        g1_0.youtube_url 
    from
        game g1_0 
    join
        game_genres g2_0 
            on g1_0.id=g2_0.game_id 
    join
        genre g2_1 
            on g2_1.id=g2_0.genre_id 
    join
        game_platforms p1_0 
            on g1_0.id=p1_0.game_id 
    join
        platform p1_1 
            on p1_1.id=p1_0.platform_id 
    where
        g1_0.slug=?
